# Скопируйте этот файл под именем .env и впишите свои значения.

# Токен бота — выдаёт @BotFather (выглядит как 1234567890:AAH...)
BOT_TOKEN=123456:ВСТАВЬТЕ_СЮДА_ТОКЕН

# Ваш Telegram ID (число) — узнать у @userinfobot.
